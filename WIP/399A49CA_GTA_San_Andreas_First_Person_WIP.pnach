gametitle=Grand Theft Auto - San Andreas (NTSC-U) SLUS-20946 [399A49CA]

[GTA-PS2-Modern-Controls\First Person\Enable]
author=Zeroable
description=Closest on-foot camera with free vertical look. Default distance -2.35; height +0.65. Disable other camera cheats. Fully restart the game with this cheat disabled to undo the instruction patch.
// Restore the verified original follow-ped instruction by default.
patch=1,EE,202095E0,extended,461F0040
// Apply only when closest zoom is selected and CCam0 is FOLLOWPED (mode 4).
patch=1,EE,E0040001,extended,006FE5F8
patch=1,EE,E0030004,extended,006FE6B0
// Retain the previous clearance position; do not freeze any pitch field.
patch=1,EE,206FE780,extended,C0166666
patch=1,EE,206FE78C,extended,3F266666
// add.s f1,f0,f2: current pitch + smoothed vertical input * time step.
// Original: add.s f1,f0,f31, where f31 is the follow-camera correction.
patch=1,EE,202095E0,extended,46020040

[GTA-PS2-Modern-Controls\First Person\Hide Body]
